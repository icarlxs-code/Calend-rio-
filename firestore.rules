rules_version = '2';
// Regras de segurança do Firebase.
// Os e-mails abaixo são preenchidos automaticamente a partir do config.js
// quando o servidor é publicado pelo GitHub (Actions). Se for colar à mão no
// console (Firestore Database > Regras), troque pelos e-mails de vocês.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && request.auth.token.email in ['icarlxs@gmail.com', 'contatopedrazzi1@gmail.com'];
    }

    // ---------- nada some sem a pessoa pedir ----------
    // Apagar = marcar "deletedAt" (o conteúdo fica) por 24 h. Só depois disso dá para apagar de vez.
    function naLixeira(d) { return d.get('deletedAt', null) != null; }
    // criar: nunca já apagado, nunca a marca antiga "_del"
    function criaOk() { return !('_del' in request.resource.data) && !naLixeira(request.resource.data); }
    // marca da lixeira: por quem está logado e com 24 h exatas
    function marcaOk() {
      return request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt is int && request.resource.data.purgeAt is int
        && request.resource.data.purgeAt == request.resource.data.deletedAt + 86400000
        && request.resource.data.deletedAt <= request.time.toMillis() + 600000;
    }
    // o essencial de um item nunca é tirado numa edição
    function fica(k) { return !(k in resource.data) || k in request.resource.data; }
    function editaOk() {
      return !('_del' in request.resource.data)
        && fica('title') && fica('date') && fica('name') && fica('text') && fica('kind') && fica('entries')
        && (naLixeira(resource.data)
          // está na lixeira: continua nela (edição de outro aparelho) ou é restaurado de propósito (deletedAt: null)
          ? ('deletedAt' in request.resource.data
             && (request.resource.data.deletedAt == null
                 || (request.resource.data.deletedAt == resource.data.deletedAt && request.resource.data.purgeAt == resource.data.purgeAt && request.resource.data.deletedBy == resource.data.deletedBy)))
          : (!naLixeira(request.resource.data) || marcaOk()));
    }
    // apagar de vez: só depois das 24 h na lixeira
    function venceu() {
      return resource.data.get('deletedAt', null) is int && resource.data.get('purgeAt', null) is int
        && resource.data.purgeAt >= resource.data.deletedAt + 86400000
        && resource.data.purgeAt < request.time.toMillis();
    }
    // exceção (LGPD): a própria pessoa excluindo a conta, com login e marca feitos há menos de 10 minutos
    function apagandoConta(uid) {
      return request.auth.uid == uid
        && request.time.toMillis() - request.auth.token.auth_time * 1000 < 600000
        && get(/databases/$(database)/documents/users/$(uid)).data.get('accountDeletion', null) != null
        && request.time.toMillis() - get(/databases/$(database)/documents/users/$(uid)).data.accountDeletion.at.toMillis() < 600000;
    }

    // Dados internos da dupla: só Henrique e Matheus leem e escrevem
    match /companies/{id} { allow read: if isTeam(); allow create: if isTeam() && criaOk(); allow update: if isTeam() && editaOk(); allow delete: if isTeam() && venceu(); }
    match /events/{id}    { allow read: if isTeam(); allow create: if isTeam() && criaOk(); allow update: if isTeam() && editaOk(); allow delete: if isTeam() && venceu(); }
    match /notes/{id}     { allow read: if isTeam(); allow create: if isTeam() && criaOk(); allow update: if isTeam() && editaOk(); allow delete: if isTeam() && venceu(); }
    match /settings/{id}  { allow read: if isTeam(); allow create: if isTeam() && criaOk(); allow update: if isTeam() && editaOk(); allow delete: if isTeam() && venceu(); }

    // Agenda pessoal: cada um vê só a sua (nem o parceiro acessa)
    match /pessoal/{uid}/{rest=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && criaOk();
      allow update: if request.auth != null && request.auth.uid == uid && editaOk();
      allow delete: if request.auth != null && request.auth.uid == uid && (venceu() || apagandoConta(uid));
    }

    // Notificações: aparelhos cadastrados, pedidos de teste e registro de atividade
    match /devices/{id}   { allow read, write: if isTeam(); }
    match /pings/{id}     { allow create: if isTeam(); }
    match /activity/{id}  { allow create: if isTeam(); }
    match /meta/{id}      { allow read: if isTeam(); }

    // Cronograma público de cada empresa (link do cliente).
    // Qualquer pessoa COM o link lê UM cronograma; ninguém consegue listar os outros.
    match /public/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isTeam() || (request.auth != null && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isTeam() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // Contas próprias: cada uma acessa o próprio espaço.
    // Agenda compartilhada (complemento pago): quem o dono aceitou na equipe também acessa o espaço dele.
    function teamOf(owner) {
      return get(/databases/$(database)/documents/teams/$(owner)).data;
    }
    function inTeam(owner) {
      return request.auth != null
        && exists(/databases/$(database)/documents/teams/$(owner))
        && teamOf(owner).active == true
        && request.auth.uid in teamOf(owner).members;
    }
    match /ws/{uid}/{rest=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || inTeam(uid));
      allow create: if request.auth != null && (request.auth.uid == uid || inTeam(uid)) && criaOk();
      allow update: if request.auth != null && (request.auth.uid == uid || inTeam(uid)) && editaOk();
      allow delete: if request.auth != null && ((request.auth.uid == uid && (venceu() || apagandoConta(uid))) || (inTeam(uid) && venceu()));
    }

    // Equipe da agenda compartilhada: o dono controla; o convidado só entra (gastando um convite válido,
    // se houver vaga e o plano estiver ativo) ou sai. Cada um só mexe no próprio nome.
    function onlyMyName() {
      return !('names' in request.resource.data) || !('names' in resource.data)
        || request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]);
    }
    match /teams/{owner} {
      allow read: if request.auth != null && (request.auth.uid == owner || request.auth.uid in resource.data.members);
      allow create, delete: if request.auth != null && request.auth.uid == owner;
      allow update: if request.auth != null && (
        request.auth.uid == owner
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyMyName()
          && resource.data.active == true
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= resource.data.seats
          && existsAfter(/databases/$(database)/documents/teams/$(owner)/joins/$(request.auth.uid))
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && onlyMyName()
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
        )
        // quem está na equipe atualiza só o próprio nome/cor/nível (placar da equipe)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
          && onlyMyName()
          && request.auth.uid in resource.data.members
        )
      );
      // entrada na equipe: só gastando, nesta mesma hora, um convite deste dono que ainda não foi usado
      match /joins/{uid} {
        allow read, delete: if request.auth != null && (request.auth.uid == owner || request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid && uid != owner
          && request.resource.data.token is string
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.owner == owner
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.used == false
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.usedBy == request.auth.uid;
      }
    }

    // Convites: um por pessoa, código aleatório de 32 caracteres, uso único, vale 7 dias.
    // Quem tem o link lê (para ver quem convidou); ninguém consegue listar os convites dos outros.
    match /invites/{token} {
      allow get: if token.size() == 32;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && token.size() == 32
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 86400000;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid != resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && resource.data.expiresAt > request.time.toMillis()
        && existsAfter(/databases/$(database)/documents/teams/$(resource.data.owner)/joins/$(request.auth.uid));
    }

    // Resumo de uso de cada conta: a própria conta grava; só o dono do app lê (Painel do dono)
    match /stats/{uid} {
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'icarlxs@gmail.com');
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // /private (chaves do servidor) e /sent (controle de envios):
    // ninguém acessa pelo app; só o servidor.
  }
}
